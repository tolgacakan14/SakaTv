<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 ve sonrası: bulut yedeği ve cihazdan cihaza aktarım. cacheDir (afişler) dahil değil. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
